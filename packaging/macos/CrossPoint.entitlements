<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a Mac App Store / TestFlight build.

  App Sandbox is mandatory for Mac App Store distribution; an unsandboxed
  bundle is rejected at upload. The other three keys are the minimum the
  simulator needs to function once sandboxed.

  FIXED 2026-09-13. The note is kept because its reasoning still explains why
  network.client below was never enough on its own. SimHttpFetch.h used to
  shell out to curl via popen(); the sandbox blocks spawning binaries outside
  the bundle, so OPDS/catalog downloads, KOReader sync and SD-font fetches
  failed in a sandboxed build no matter which network entitlement was granted.
  On macOS it now calls libcurl IN PROCESS (CROSSPOINT_SIM_LIBCURL, decided by
  a platform test in the header itself), so there is no subprocess left to
  forbid. Anything added later that shells out will hit the same wall again.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Host-backed HTTP/HTTPS fetches. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The firmware web server / WebDAV routes bind localhost 8080 and 8081. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Importing EPUBs the user picks in an open panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
