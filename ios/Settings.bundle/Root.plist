		<dict>
			<key>FooterText</key>
			<string>Just the page: the button pad disappears and the page fills the screen, with every control on a gesture. Hold one finger above the page for three quarters of a second to turn zen on or off without leaving the book — or use the switch below.</string>
			<key>Title</key>
			<string>Zen</string>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
		</dict>
		<dict>
			<key>DefaultValue</key>
