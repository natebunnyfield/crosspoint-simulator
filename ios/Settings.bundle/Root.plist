			<string>Preset</string>
			<key>Titles</key>
			<array>
				<string>Current</string>
				<string>Accessible — 3:1</string>
				<string>Transparent — nothing drawn</string>
				<string>Custom — use the settings below</string>
			</array>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Values</key>
			<array>
				<integer>1</integer>
				<integer>2</integer>
				<integer>3</integer>
				<integer>0</integer>
			</array>
