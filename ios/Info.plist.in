<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>CrossPoint X3</string>
  <key>CFBundleDisplayName</key>
  <string>CrossPoint X3</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Both are set from CMake so the deploy script can bump them without
       editing this file. CFBundleVersion must be unique per marketing version,
       and TestFlight's daily upload cap (error 90382) is ALSO per marketing
       version, so hitting it means bumping CFBundleShortVersionString, not
       waiting a day. -->
  <key>CFBundleShortVersionString</key>
  <string>@CROSSPOINT_IOS_MARKETING_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@CROSSPOINT_IOS_BUILD_NUMBER@</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>

  <!-- No encryption beyond what the OS provides. Declaring it here means
       TestFlight uploads skip the export-compliance prompt every time. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- Portrait only. The X3 panel is presented portrait and the control zones
       are laid out beneath it (phone) or beside it (iPad); rotation would
       invalidate the integer-scale geometry the 1-bit panel depends on.
       UIRequiresFullScreen is what makes portrait-only legal on iPad: without
       it the App Store demands all four orientations for Split View. -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UIRequiresFullScreen</key>
  <true/>

  <!-- Background audio, so read-aloud survives the screen locking. Half of a
       pair: without AVAudioSessionCategoryPlayback (set in
       CrossPointReadAloud.mm) this entry grants nothing, and without this
       entry the playback session is cut off the moment the app leaves the
       foreground. The grant lasts only while audio is actually playing, which
       is why that file hands the session back after the reader has been
       stopped for a moment — an app that keeps an idle session keeps running,
       and this loop runs at ~1 kHz.

       It also keeps the FIRMWARE alive while locked, which is what turns the
       pages: the page-forward tap is a real button press handled by the
       firmware loop, so suspending the process would end the reading at the
       bottom of the current page.

       ADD ONLY, NEVER REMOVE, in this file: it is the source of truth for the
       privacy purpose strings App Store review scans for. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>

  <!-- File sharing, so EPUB/TXT can be sideloaded via Files. The real X3 has no
       USB port (pogo pins), so this is the only practical way to get books in. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>

  <!-- Tapping an .epub in Files/Mail/AirDrop, or the Share Sheet, now offers
       "Copy to CrossPoint X3" / "Open in CrossPoint X3". org.idpf.epub-container
       is a system UTI (Apple Books registers it too) so no UTExportedTypeDeclarations
       are needed -- we are only a consumer of it. LSHandlerRank Alternate: this
       app imports the book onto the simulated SD card, it does not edit the
       original in place, so it should not compete to be the default EPUB viewer. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>EPUB Book</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.idpf.epub-container</string>
      </array>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
  </array>

  <!-- Networking. The file-transfer screen serves the firmware's web UI to a
       peer on the same WiFi, and reports which network the phone is on.

       NSLocationWhenInUseUsageDescription is NOT about location as a feature:
       NEHotspotNetwork.fetchCurrent, the only public way to read the current
       SSID and signal strength, is gated behind Location authorization. Without
       it the file-transfer screen cannot name the network or draw signal bars.

       NSLocalNetworkUsageDescription + NSBonjourServices are required because
       the firmware advertises crosspoint.local as the PRIMARY address, and QR-
       encodes it; without Bonjour that address resolves to nothing. See
       ios/WIFI.md. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>CrossPoint serves your books to other devices on this network during file transfer.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_http._tcp</string>
  </array>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>CrossPoint uses location permission only to read the name and signal strength of the Wi-Fi network you are on, which it shows on the file transfer screen. Your location is never stored or sent anywhere.</string>
  <!-- There is deliberately NO NSCameraUsageDescription here. Read-aloud links
       AVFoundation for AVSpeechSynthesizer, and for one build (39) that alone
       made the deploy guard demand the camera string -- but linking a framework
       is not referencing an API. Measured on that build: zero AVCapture class
       refs, zero camera selectors, SDL built with SDL_CAMERA_DISABLED. The
       guard in ios/testflight.sh now tests SYMBOLS (an undefined
       _OBJC_CLASS_$_AVCapture* means use; SDL's own camera driver classes mean
       use) and will demand the key again the day either appears. If Apple ever
       rejects with ITMS-90683 naming the camera while those are all zero,
       re-add the key AND record the build number next to it. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string></string>
  </dict>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>UIStatusBarHidden</key>
  <true/>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
</dict>
</plist>
